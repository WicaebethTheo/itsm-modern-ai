# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.venv/
venv/
# Sorties de coverage.py (rapports locaux — jamais committés)
.coverage
.coverage.*
htmlcov/
coverage.xml

# Env & secrets — JAMAIS committer (invariant souveraineté / secrets chiffrés)
.env
*.key
master.key

# Données locales
*.db
*.sqlite3
data/

# Sorties du spike
spike-report*.json
spike-report*.md

# Node — présent ici AUSSI, pas seulement dans frontend/.gitignore : un outil lancé
# depuis la racine (un `npx vitest` sur le mauvais répertoire, par exemple) y crée un
# `node_modules/` que `git add -A` embarquerait sans bruit.
node_modules/
.vite/
# Rapports de couverture front (vitest --coverage)
coverage/

# OS / IDE
.DS_Store
.idea/
.vscode/

# Mockups / images de travail
Untitled.png
*.mockup.png

# Notes internes (planning, archives) — non publié
notes/

# Sauvegardes locales créées par update.sh (base + master.key)
backups/
