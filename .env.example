# ⚠️ Les SECRETS NE SONT PLUS dans .env : la clé API LLM et les tokens GLPI se
# poussent au runtime via l'API/UI de configuration (POST /api/config) et sont
# stockés CHIFFRÉS au repos (FR-25). .env ne porte que des réglages non-secrets,
# la master key de chiffrement et l'URL de base de données.

# ── Persistance ───────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./data/itsm.db
# PostgreSQL (Beta, cf. docs/postgresql.md) — driver psycopg 3 (extra `postgres`).
# DATABASE_URL=postgresql+psycopg://itsm:itsm@localhost:5432/itsm
# Pool de connexions (ignoré en SQLite) :
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_PRE_PING=true
#
# Docker Compose : pour activer le service postgres optionnel (profile `postgres`),
# définir ces variables puis `docker compose --profile postgres up -d --build` :
# ITSM_DATABASE_URL=postgresql+psycopg://itsm:itsm@postgres:5432/itsm
# POSTGRES_USER=itsm
# POSTGRES_PASSWORD=itsm
# POSTGRES_DB=itsm

# ── Chiffrement des secrets au repos (FR-25) ─────────────────────────────────
# Clé Fernet (urlsafe base64, 32 octets). Si vide, une clé est générée et
# persistée dans data/master.key. En prod : monter un secret. Générer une clé :
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MASTER_KEY=

# ── Connecteur LLM — réglages NON-secrets (la clé se pousse via l'UI) ──────────
# Fournisseur : mistral (souverain, défaut) | openai | ollama (local) | anthropic.
# NB : ces réglages sont AUSSI modifiables dans l'UI (source de vérité runtime) ;
# .env ne sert que de défaut au premier démarrage.
# LLM_PROVIDER=mistral
LLM_BASE_URL=https://api.mistral.ai/v1
LLM_MODEL=mistral-large-latest
LLM_PRICE_INPUT_PER_MTOK=2.0
LLM_PRICE_OUTPUT_PER_MTOK=6.0
# Variantes par fournisseur (décommenter selon LLM_PROVIDER) :
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=llama3.1
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Moteur à garde-fous ───────────────────────────────────────────────────────
CONFIDENCE_THRESHOLD=0.7
COST_CAP_EUR_PER_DAY=5.0

# ── Connexion GLPI legacy apirest.php (FR-1) — base_url non-secret ────────────
# Les tokens (GLPI_USER_TOKEN, GLPI_APP_TOKEN) se poussent via POST /api/config.
GLPI_BASE_URL=
GLPI_VERIFY_TLS=true
GLPI_TIMEOUT_SECONDS=30
# True si GLPI 9.x (TicketFollowup). False (défaut) pour 10.x+ (ITILFollowup).
GLPI_FOLLOWUP_LEGACY_9X=false

# Choix de l'API GLPI (Beta) : `legacy` (apirest.php, défaut éprouvé) | `v2` (API
# haut-niveau OAuth2 de GLPI 11, cf. docs/glpi-api-v2.md). En mode v2, l'auth se fait par
# client OAuth + compte technique, et l'URL V2 est DISTINCTE de l'URL legacy (les deux
# coexistent : GLPI_BASE_URL = …/apirest.php, GLPI_V2_BASE_URL = …/api.php/v2.3).
# GLPI_API_VERSION=legacy
# GLPI_V2_BASE_URL=
# Scopes OAuth demandés (espace) ; `api` = tickets/référentiels, `user` = aperçu du compte.
# GLPI_OAUTH_SCOPE=api user
# Identifiants OAuth V2 — non-secrets (visibles UI) ; le client_secret et le mot de passe
# se poussent via l'UI/POST /api/config (secrets chiffrés), JAMAIS dans .env.
# GLPI_OAUTH_CLIENT_ID=
# GLPI_OAUTH_USERNAME=

# ── Polling (FR-2) ────────────────────────────────────────────────────────────
POLLING_ENABLED=true
POLLING_INTERVAL_SECONDS=60
POLLING_MAX_TICKETS=200

# ── Authentification locale (FR-24) ──────────────────────────────────────────
# RECOMMANDÉ : définissez le mot de passe admin via `./install.sh` (ou
# `docker compose exec itsm python -m itsm_modern_ai.admin_setup`). Il est alors
# stocké UNIQUEMENT en hash Argon2 chiffré, jamais en clair ici.
#
# ADMIN_PASSWORD ci-dessous = amorçage FALLBACK optionnel (déploiement non-interactif/CI) :
# s'il est défini ET qu'aucun hash n'existe encore, il est hashé au 1er démarrage. Une fois
# le hash en base, cette valeur est IGNORÉE → videz-la après le premier boot.
# FAIL-CLOSED : sans hash ni ADMIN_PASSWORD, les endpoints d'admin sont REFUSÉS (401).
# ADMIN_PASSWORD=

# Réouvrir volontairement l'admin SANS mot de passe (dev/labo uniquement, JAMAIS
# en prod). Sans ce flag, l'absence de mot de passe = accès refusé (fail-closed).
# DEV_OPEN_ADMIN=true

# Cookie de session : flag Secure (https_only). Défaut sûr = true (prod TLS).
# ⚠️ Si l'app est servie en HTTP (pas de reverse-proxy TLS devant), mettre à false :
# sinon le navigateur n'envoie jamais le cookie et le login BOUCLE (200 puis déconnecté).
# SESSION_HTTPS_ONLY=false

# Rate-limiting du login (anti brute-force, limiteur EN MÉMOIRE par IP). 0 = désactivé.
# LOGIN_MAX_ATTEMPTS=5      # échecs tolérés dans la fenêtre avant blocage
# LOGIN_WINDOW_SECONDS=300  # fenêtre glissante d'observation des échecs
# LOGIN_BLOCK_SECONDS=300   # durée du blocage une fois le seuil franchi

# ── Reverse proxy (FR-26) ────────────────────────────────────────────────────
# Si activé, le moteur lit la 1ʳᵉ valeur de `X-Forwarded-For` pour déduire l'IP
# réelle du client (rate-limit login + audit). NE PAS activer sans proxy fiable
# devant (sinon un attaquant peut forger l'IP via le header).
# TRUST_PROXY_HEADERS=true  # à activer derrière un reverse proxy fiable

# ── Observabilité — logging structuré ─────────────────────────────────────────
# Niveau de log racine : DEBUG | INFO | WARNING | ERROR | CRITICAL.
# LOG_LEVEL=INFO
# Format : `text` (lisible, dev) ou `json` (1 ligne = 1 objet JSON, agrégation
# Loki/ELK). Le format JSON n'inclut AUCUNE PII (ni corps de requête, ni query string).
# LOG_FORMAT=text

# ── Observabilité — métriques Prometheus (/metrics) ───────────────────────────
# Endpoint /metrics activable/désactivable. Désactiver = endpoint absent (404).
# METRICS_ENABLED=true
# Jeton de scrape OPTIONNEL : si défini, /metrics exige `Authorization: Bearer <jeton>`
# (ou en-tête `X-Metrics-Token`), sinon 401. Vide = non authentifié (scrape interne
# classique, rétrocompatible). À définir pour fermer l'exposition de la volumétrie/latence.
# METRICS_TOKEN=

# ── Sécurité — garde anti-SSRF au runtime (anti DNS rebinding) ────────────────
# Quand activé (défaut), chaque appel sortant (LLM, GLPI) résout l'hôte et BLOQUE
# toute IP privée/loopback/link-local/metadata AVANT d'émettre la requête (donc avant
# toute fuite de token).
# ⚠️ GLPI ON-PREM : si ton GLPI résout vers une IP privée (cas NORMAL en réseau interne),
# ce garde-fou bloque tout appel GLPI → polling/auto-triage à l'arrêt et /health en 503.
# Le désactiver est alors nécessaire (réseau de confiance), au prix de la protection
# anti-rebinding sur l'appel LLM externe. Décision explicite de l'admin.
# SSRF_GUARD_ENABLED=true

# ── UI web (Phase 2) ──────────────────────────────────────────────────────────
# SPA React buildée, servie en statique par le moteur (rien à configurer en prod).
# Les fiches techniciens, la clé LLM/Anthropic et la connexion GLPI se gèrent
# entièrement DANS L'INTERFACE — aucun fichier à monter.
# FRONTEND_DIST=frontend/dist

# ── Outils de DEBUG (diagnostics + jeux de test GLPI, dont actions DESTRUCTIVES) ─
# DÉSACTIVÉ par défaut → inerte en production. À n'activer qu'en labo/test.
# DEBUG_TOOLS_ENABLED=false

# ── Spike CLI uniquement (Epic 1, homelab) — PAS utilisé par le runtime ───────
# LLM_API_KEY=changeme-mistral-eu-key

# ── Édition Enterprise (open-core) — cf. docs/enterprise-upgrade.md ───────────
# Déploiement Community par défaut. Pour passer en Enterprise SANS rien perdre :
# garder le même ./data, définir le tag d'image Enterprise + la clé de licence
# (ou utiliser ./upgrade-to-enterprise.sh). Vider ces lignes = retour Community.
# ITSM_IMAGE=itsm-modern-ai-enterprise:latest
# LICENSE_KEY=itsm-lic.v1.…
