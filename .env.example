# ── Connecteur LLM (FR-11/FR-13) ─────────────────────────────────────────────
# Chemin OpenAI-compatible. Défaut souverain recommandé : Mistral EU.
LLM_BASE_URL=https://api.mistral.ai/v1
LLM_MODEL=mistral-large-latest
LLM_API_KEY=changeme-mistral-eu-key
# Tarifs (€/million de tokens) pour le compteur de coût du spike / le cost cap (FR-10).
LLM_PRICE_INPUT_PER_MTOK=2.0
LLM_PRICE_OUTPUT_PER_MTOK=6.0

# ── Moteur à garde-fous ───────────────────────────────────────────────────────
# Seuil de confiance (FR-8). Valeur de DÉPART, à calibrer pendant le spike/pilote.
CONFIDENCE_THRESHOLD=0.7
# Cost cap quotidien en euros (FR-10) — utilisé en Phase 1, indicatif au spike.
COST_CAP_EUR_PER_DAY=5.0

# ── Connexion GLPI (FR-1, Epic 2 — non utilisé par le spike) ──────────────────
# GLPI_BASE_URL=https://glpi.exemple.local/apirest.php
# GLPI_APP_TOKEN=
# GLPI_USER_TOKEN=
# POLLING_INTERVAL_SECONDS=60
