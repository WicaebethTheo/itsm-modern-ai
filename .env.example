# ITSM Modern AI - configuration (.env)
#
# Pas de secrets ici : la cle LLM et les tokens GLPI se saisissent dans l'UI
# (chiffres au repos). .env ne porte que des reglages non-secrets + la master key.
# Options avancees (GLPI API v2, metriques, anti-SSRF, reverse proxy) :
# https://docs.itsm-modern-ai.com

# --- Persistance : PostgreSQL (seule base supportee) ---
#
# DEUX variables, et ce n'est PAS un doublon :
#
#   * ITSM_DATABASE_URL  -> lue par docker-compose.yml, qui la pose dans `environment:`
#     sous le nom DATABASE_URL. C'est LA molette a tourner sous compose.
#   * DATABASE_URL       -> lue directement par le moteur. Sous compose elle est INUTILE :
#     `environment:` a la PRIORITE sur `env_file:`, donc la valeur ecrite ici serait
#     silencieusement ecrasee (c'etait le piege avant 0.9.57). Elle ne sert qu'a une
#     execution DEPUIS LES SOURCES (make run / make migrate / pytest), ou le defaut du
#     code (localhost:5432) convient deja.
#
# DATABASE_URL=postgresql+psycopg://itsm:itsm@localhost:5432/itsm

# Base de la stack compose. Ces trois variables ne servent qu'a l'INITIALISATION du
# cluster (premier demarrage, ./data/postgres vide) : les changer ensuite n'a AUCUN effet
# sur une base existante (il faut alors `ALTER USER itsm PASSWORD '...'`).
POSTGRES_USER=itsm
POSTGRES_DB=itsm
# ⚠️ A CHANGER AVANT MISE EN SERVICE, et AVANT le tout premier demarrage. La base n'est
# pas publiee sur l'hote (aucun `ports:`), mais ce mot de passe protege l'integralite des
# donnees RGPD face a tout ce qui atteint le reseau Docker.
POSTGRES_PASSWORD=changez-moi-avant-le-premier-demarrage
# ⚠️ DOIT rester COHERENT avec les trois lignes ci-dessus (meme utilisateur, meme mot de
# passe, meme base) : c'est le moteur qui s'en sert pour joindre `postgres`. Un mot de
# passe contenant @ : / ? # doit y etre encode-URL (%40, %3A, ...).
ITSM_DATABASE_URL=postgresql+psycopg://itsm:changez-moi-avant-le-premier-demarrage@postgres:5432/itsm

# --- Chiffrement des secrets au repos ---
# Cle Fernet ; si vide, generee et persistee dans data/master.key au 1er demarrage.
MASTER_KEY=

# --- Amorcage admin (deploiement orchestrateur / non-interactif) ---
# Si defini, le compte admin est amorce AU PREMIER BOOT par l'entrypoint (idempotent :
# ignore si deja configure, jamais ecrase). Minimum 8 caracteres. Retirable apres le
# 1er demarrage (le hash est persiste chiffre dans le volume). Vide = pas d'amorcage
# automatique (mot de passe demande par install.sh, ou via curl|bash interactif).
# Alias accepte : ADMIN_PASSWORD (meme effet).
# ITSM_ADMIN_PASSWORD=

# --- LLM (defauts ; aussi modifiables dans l'UI) ---
# Souverain par defaut : Mistral EU. Autres : openai | ollama | anthropic.
LLM_BASE_URL=https://api.mistral.ai/v1
LLM_MODEL=mistral-large-latest

# --- Moteur a garde-fous ---
CONFIDENCE_THRESHOLD=0.7
# Fuseau LOCAL de l'équipe (IANA). Sert à évaluer les congés : bornes inclusives,
# granularité jour. En UTC, un congé finirait à 02 h du matin le bon jour (ou la
# veille selon la saison) pour une équipe à Paris. Modifiable aussi dans la console.
LOCAL_TIMEZONE=Europe/Paris
COST_CAP_EUR_PER_DAY=5.0

# --- GLPI (base_url non-secret ; les tokens se poussent via l'UI) ---
GLPI_BASE_URL=
GLPI_VERIFY_TLS=true
# On-premise : le GLPI est presque toujours sur IP/hostname PRIVE (RFC1918, .local,
# loopback). Ce flag (defaut true) autorise une cible privee pour les SEULS clients GLPI
# (le garde anti-SSRF reste strict pour le LLM et l'update-check). Passer a false uniquement
# si votre GLPI est expose sur une URL publique et que vous voulez le durcissement complet.
GLPI_ALLOW_PRIVATE=true

# --- Polling ---
POLLING_ENABLED=true
POLLING_INTERVAL_SECONDS=60
POLLING_MAX_TICKETS=200

# --- Session ---
# Cookie Secure. Defaut false (pilote HTTP) ; repasser a true derriere un TLS.
SESSION_HTTPS_ONLY=false

# --- Supporter (optionnel) ---
# Les fonctions Supporter sont livrees mais verrouillees : coller la cle dans la
# page Supporter de la console (Ed25519, verifiee hors-ligne). Ligne ci-dessous =
# pre-amorcage optionnel pour les deploiements automatises ; vide = Community.
# LICENSE_KEY=itsm-lic.v1.xxx

# --- Verification de mise a jour ---
# ACTIVEE PAR DEFAUT (opt-out). Defaut :
#   https://api.github.com/repos/WicaebethTheo/itsm-modern-ai/releases/latest
# Best-effort, en cache (1 h), declenchee quand un admin authentifie ouvre la console :
# lit UNIQUEMENT le dernier numero de version publie + les notes de release ; aucune
# donnee de l'instance n'est envoyee.
# Air-gap / 100% hors-ligne : decommentez la ligne ci-dessous (valeur vide = aucun appel).
# UPDATE_CHECK_URL=

# --- Recuperation apres incident (0.9.48) ---
# Le moteur REFUSE de demarrer s'il ne trouve plus data/master.key alors que des secrets
# chiffres existent deja : mieux vaut un arret explicite qu'une instance qui demarre
# « verte » avec des secrets illisibles et un login qui repond « mot de passe incorrect ».
# Pour repartir de zero en connaissance de cause (tous les secrets seront a re-saisir) :
# ITSM_ALLOW_NEW_MASTER_KEY=true

# Version d'image tiree par le stack Portainer. Vide = latest. A epingler en production
# pour qu'un redeploiement ne tire pas silencieusement une version plus recente.
# ITSM_IMAGE_TAG=0.9.48
