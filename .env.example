# ITSM Modern AI — configuration (.env)
#
# Pas de secrets ici : la clé LLM et les tokens GLPI se saisissent dans l'UI
# (chiffrés au repos). .env ne porte que des réglages non-secrets + la master key.
# Options avancées (PostgreSQL, GLPI API v2, métriques Prometheus, anti-SSRF,
# reverse proxy, observabilité…) : https://docs.itsm-modern-ai.com

# ── Persistance ───────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./data/itsm.db

# ── Chiffrement des secrets au repos ──────────────────────────────────────────
# Clé Fernet ; si vide, générée et persistée dans data/master.key au 1er démarrage.
MASTER_KEY=

# ── LLM (défauts ; aussi modifiables dans l'UI) ───────────────────────────────
# Souverain par défaut : Mistral EU. Autres fournisseurs : openai | ollama | anthropic.
LLM_BASE_URL=https://api.mistral.ai/v1
LLM_MODEL=mistral-large-latest

# ── Moteur à garde-fous ───────────────────────────────────────────────────────
CONFIDENCE_THRESHOLD=0.7
COST_CAP_EUR_PER_DAY=5.0

# ── GLPI (base_url non-secret ; les tokens se poussent via l'UI) ──────────────
GLPI_BASE_URL=
GLPI_VERIFY_TLS=true

# ── Polling ───────────────────────────────────────────────────────────────────
POLLING_ENABLED=true
POLLING_INTERVAL_SECONDS=60
POLLING_MAX_TICKETS=200

# ── Session ───────────────────────────────────────────────────────────────────
# Cookie Secure. Défaut false (pilote HTTP) ; repasser à true derrière un TLS.
SESSION_HTTPS_ONLY=false

# ── Supporter (optionnel) ─────────────────────────────────────────────────────
# Les fonctions Supporter sont livrées mais verrouillées : coller la clé dans la
# page Supporter de la console (Ed25519, vérifiée hors-ligne). La ligne ci-dessous
# est un pré-amorçage optionnel pour les déploiements automatisés ; vide = Community.
# LICENSE_KEY=itsm-lic.v1.…
